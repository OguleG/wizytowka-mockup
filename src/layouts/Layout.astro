---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'C-TECH  -  Full Ship Service',
  description = 'Full ship service: vessel inspections, dry-dock planning and supervision, steel and engine works, electrics, purchasing, and more.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
